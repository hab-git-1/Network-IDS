alert icmp any any -> $HOME_NET any (msg:"LAB ICMP ping detected"; itype:8; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"LAB TCP SYN port scan"; flags:S,12; threshold:type threshold, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH brute-force attempt"; flow:to_server; flags:S,12; threshold:type threshold, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000003; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB SQL injection UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000004; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB XSS script tag"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1000005; rev:1;)
alert http any any -> $HOME_NET any (msg:"LAB Directory traversal"; flow:established,to_server; http.uri.raw; content:"../"; classtype:web-application-attack; sid:1000006; rev:1;)
